:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    @buildAssets path /build/assets/*
    header @buildAssets >Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"

    @boundaryFile path /geo/kab-semarang.json
    header @boundaryFile >Cache-Control "public, max-age=3600, s-maxage=3600"

    php_server {
        try_files {path} index.php
    }
}
